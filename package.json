{
  "name": "retentia",
  "version": "0.2.0",
  "displayName": "Retentia",
  "description": "Personal memory, RAG, and agent graph engine for ChatGPT Codex and Claude Code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "retentia": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "install:mcp": "npm run build && node dist/cli.js install",
    "vscode:build": "npm --prefix vscode-extension run build",
    "vscode:package": "npm --prefix vscode-extension run package",
    "install:vscode": "node scripts/vscode-install.mjs install",
    "reinstall:vscode": "node scripts/vscode-install.mjs reinstall",
    "dev": "tsx src/cli.ts mcp",
    "start": "node dist/cli.js mcp"
  },
  "keywords": [
    "retentia",
    "codex",
    "mcp",
    "memory",
    "rag",
    "claude",
    "multi-agent"
  ],
  "author": "imre_gi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imre-gi/retentia.git"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
