{
    "name": "retentia-vscode",
    "displayName": "Retentia",
    "description": "Retentia command center for memory, RAG, context budgets, and Copilot/Codex/Claude Code agent visibility inside VS Code",
    "version": "0.1.1",
    "publisher": "local",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/imre-gi/retentia.git",
        "directory": "vscode-extension"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "retentia.installMcp",
                "title": "Retentia: Install MCP for Codex"
            },
            {
                "command": "retentia.initStore",
                "title": "Retentia: Initialize Store"
            },
            {
                "command": "retentia.syncTasks",
                "title": "Retentia: Import Copilot, Codex, and Claude Code Tasks"
            },
            {
                "command": "retentia.doctor",
                "title": "Retentia: Run Doctor"
            },
            {
                "command": "retentia.projectExplorer",
                "title": "Retentia: Agent Command Center"
            },
            {
                "command": "retentia.statusDashboard",
                "title": "Retentia: Inspect Agents and Swarms"
            },
            {
                "command": "retentia.openSettings",
                "title": "Retentia: Open Settings"
            },
            {
                "command": "retentia.addObservation",
                "title": "Retentia: Add Memory"
            },
            {
                "command": "retentia.addSummary",
                "title": "Retentia: Save Session Memory"
            },
            {
                "command": "retentia.search",
                "title": "Retentia: Search Memory"
            },
            {
                "command": "retentia.contextPack",
                "title": "Retentia: Generate Context Pack"
            },
            {
                "command": "retentia.openMemoryFile",
                "title": "Retentia: Open Memory File"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "retentiaSidebar",
                    "title": "Retentia",
                    "icon": "assets/retentia-dashboard-preview.svg"
                }
            ]
        },
        "views": {
            "retentiaSidebar": [
                {
                    "type": "webview",
                    "id": "retentia.quickInput",
                    "name": "Quick Input"
                }
            ]
        },
        "configuration": {
            "title": "Retentia",
            "properties": {
                "retentia.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional absolute path to the retentia CLI binary (or dist/cli.js file). Leave empty for auto-detection."
                },
                "retentia.defaultProject": {
                    "type": "string",
                    "default": "",
                    "description": "Optional default project name to use when adding entries from VS Code."
                },
                "retentia.autoSyncTasks": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically sync task-execution events from Copilot, Codex, and Claude Code into Retentia when refreshing the dashboard."
                },
                "retentia.enabledProviders": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "copilot",
                            "codex",
                            "claude-code",
                            "all"
                        ]
                    },
                    "default": [
                        "copilot",
                        "codex",
                        "claude-code"
                    ],
                    "description": "Enabled providers for task ingestion. Use 'all' for Copilot, Codex, and Claude Code."
                },
                "retentia.autoSyncLookbackDays": {
                    "type": "number",
                    "default": 7,
                    "minimum": 1,
                    "maximum": 30,
                    "description": "How many recent days of provider session logs are scanned for task execution events."
                },
                "retentia.autoSyncMaxImport": {
                    "type": "number",
                    "default": 25,
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Maximum number of new task executions imported into memory per sync run."
                },
                "retentia.autoSyncMaxFiles": {
                    "type": "number",
                    "default": 24,
                    "minimum": 1,
                    "maximum": 200,
                    "description": "Maximum number of recent session files scanned per provider during sync."
                },
                "retentia.copilotTranscriptsPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional custom path to Copilot Chat transcripts or a VS Code workspaceStorage directory. Leave empty to auto-detect common VS Code locations."
                },
                "retentia.codexSessionsPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional custom path to Codex sessions directory. Leave empty to use ~/.codex/sessions."
                },
                "retentia.claudeSessionsPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional custom path to Claude Code sessions directory. Leave empty to use ~/.claude/projects."
                },
                "retentia.dashboardLimit": {
                    "type": "number",
                    "default": 600,
                    "minimum": 50,
                    "maximum": 5000,
                    "description": "Maximum number of recent events loaded for the Retentia dashboard."
                }
            }
        }
    },
    "scripts": {
        "build": "node ../scripts/clean-dist.mjs vscode-extension/dist && tsc -p tsconfig.json",
        "package": "npm run build && vsce package --allow-missing-repository",
        "install:local": "node ./scripts/local-install.mjs",
        "uninstall:local": "node ./scripts/local-uninstall.mjs"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.6.0",
        "@types/node": "^24.6.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.9.3"
    }
}
